# 数据库：SQLite 单文件，放在 data/ 下方便挂卷备份
DATABASE_URL="file:../data/mboard.db"

# 会话签名密钥，生产环境务必改成随机长字符串
AUTH_SECRET="please-generate-a-random-long-string"

# 账号配置文件路径（相对项目根目录）
ACCOUNTS_FILE="./config/accounts.yml"

# 上传文件目录
UPLOAD_DIR="./data/uploads"

# 站点名称
APP_NAME="MBoard"

# 会话有效期（天）
SESSION_DAYS="7"

# 部署在 HTTPS 反向代理后时设为 true，让 Cookie 只走加密连接
COOKIE_SECURE="false"

# ---- 自动更新（主页「检查更新」按钮） ----
# 宿主机上本项目的绝对路径，更新容器必须把项目挂到同一路径才能正确重建
# 首次部署执行一次即可：echo "MBOARD_ROOT=$(pwd)" >> .env
# 不填也不会影响启动，只是「检查更新」会提示更新服务不可用
MBOARD_ROOT=""

